# LLMaaD — Model endpoint configuration
# Copy this file to .env and fill in your vLLM server IPs/ports.
# Source it before running experiments: source .env

# Target / reshaper models
ABLITERATED_IP=localhost
ABLITERATED_PORT=8000

VICUNA_IP=localhost
VICUNA_PORT=8000

QWEN3_IP=localhost
QWEN3_PORT=8000

# Detector
LLAMAGUARD_IP=localhost
LLAMAGUARD_PORT=8001

# Attacker judge / scorer (gpt-oss-120b or compatible)
SCORER_IP=localhost
SCORER_PORT=8000

# Attacker LLM judge (gemma or compatible)
GEMMA_IP=localhost
GEMMA_PORT=8001

# API keys — required for GPTFuzz and PAIR attacker (GPT-3.5-turbo)
OPENAI_API_KEY=sk-...

# Optional: post-hoc Claude judging (claude_judge_autodan.py)
ANTHROPIC_API_KEY=...
